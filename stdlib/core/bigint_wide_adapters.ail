@library("core_bigint_wide_adapters")
import stdlib.core.bigint
import stdlib.core.bigint_bits

// Wide fixed-width conversion adapters (u256/i256 through u8192/i8192).

pointer ailang_bigint_from_u256_value(u256 value):
    int raw = alloc(32)
    int i = 0
    while i < 4 then
        u256 shifted = value >> (i * 64)
        u64 word = shifted & 18446744073709551615
        poke64(raw, i, word)
        i += 1
    end
    int sign = 0
    if value != 0 then
        sign = 1
    end
    pointer out = ailang_bigint_from_words(sign, reinterpret(pointer, raw), 4)
    dealloc(raw)
    return out
end

pointer ailang_bigint_from_i256_value(i256 value):
    u256 mag = reinterpret(u256, value)
    int sign = 0
    if value < 0 then
        i256 neg_one = -1
        u256 all_bits = reinterpret(u256, neg_one)
        mag = (mag bxor all_bits) + 1
        sign = -1
    else
        if value > 0 then
            sign = 1
        end
    end
    int raw = alloc(32)
    int i = 0
    while i < 4 then
        u256 shifted = mag >> (i * 64)
        u64 word = shifted & 18446744073709551615
        poke64(raw, i, word)
        i += 1
    end
    pointer out = ailang_bigint_from_words(sign, reinterpret(pointer, raw), 4)
    dealloc(raw)
    return out
end

u256 ailang_bigint_to_u256_value(pointer value):
    if ailang_bigint_fits_unsigned(value, 256) == 0 then
        ailang_bigint_fail("value does not fit u256")
    end
    u256 out = 0
    int i = 0
    while i < 4 then
        u256 piece = ailang_bigint_word_at(value, i)
        if i != 0 then
            piece = piece << (i * 64)
        end
        out = out | piece
        i += 1
    end
    return out
end

i256 ailang_bigint_to_i256_value(pointer value):
    if ailang_bigint_fits_signed(value, 256) == 0 then
        ailang_bigint_fail("value does not fit i256")
    end
    u256 mag = 0
    int i = 0
    while i < 4 then
        u256 piece = ailang_bigint_word_at(value, i)
        if i != 0 then
            piece = piece << (i * 64)
        end
        mag = mag | piece
        i += 1
    end
    if ailang_bigint_sign(value) < 0 then
        i256 neg_one = -1
        u256 all_bits = reinterpret(u256, neg_one)
        u256 bits = (mag bxor all_bits) + 1
        return reinterpret(i256, bits)
    end
    return reinterpret(i256, mag)
end

