i1024 ailang_bigint_to_i1024_value(pointer value):
    if ailang_bigint_fits_signed(value, 1024) == 0 then
        ailang_bigint_fail("value does not fit i1024")
    end
    u1024 mag = 0
    int i = 0
    while i < 16 then
        u1024 piece = ailang_bigint_word_at(value, i)
        if i != 0 then
            piece = piece << (i * 64)
        end
        mag = mag | piece
        i += 1
    end
    if ailang_bigint_sign(value) < 0 then
        i1024 neg_one = -1
        u1024 all_bits = reinterpret(u1024, neg_one)
        u1024 bits = (mag bxor all_bits) + 1
        return reinterpret(i1024, bits)
    end
    return reinterpret(i1024, mag)
end

pointer ailang_bigint_from_u2048_value(u2048 value):
    int raw = alloc(256)
    int i = 0
    while i < 32 then
        u2048 shifted = value >> (i * 64)
        u64 word = shifted & 18446744073709551615
        poke64(raw, i, word)
        i += 1
    end
    int sign = 0
    if value != 0 then
        sign = 1
    end
    pointer out = ailang_bigint_from_words(sign, reinterpret(pointer, raw), 32)
    dealloc(raw)
    return out
end

pointer ailang_bigint_from_i2048_value(i2048 value):
    u2048 mag = reinterpret(u2048, value)
    int sign = 0
    if value < 0 then
        i2048 neg_one = -1
        u2048 all_bits = reinterpret(u2048, neg_one)
        mag = (mag bxor all_bits) + 1
        sign = -1
    else
        if value > 0 then
            sign = 1
        end
    end
    int raw = alloc(256)
    int i = 0
    while i < 32 then
        u2048 shifted = mag >> (i * 64)
        u64 word = shifted & 18446744073709551615
        poke64(raw, i, word)
        i += 1
    end
    pointer out = ailang_bigint_from_words(sign, reinterpret(pointer, raw), 32)
    dealloc(raw)
    return out
end

