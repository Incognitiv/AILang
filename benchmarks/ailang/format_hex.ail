def format_hex_bench(iterations):
    i = 0
    sink = 0
    while i < iterations then
        h = hex(i)
        n = len(h)
        sink = sink + n + ord(char_at(h, n - 1))
        i = i + 1
    end
    return sink
end


def main(): int
    iterations = 400000
    result = format_hex_bench(iterations)
    print(result)
    return 0
end
